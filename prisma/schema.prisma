generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id                String        @id @default(uuid())
  username          String        @unique
  email             String?       @unique
  isEmailVerified   Boolean       @default(true)
  passwordHash      String?
  fullName          String?
  courtName         String?
  isProfileComplete Boolean       @default(true)
  role              Role          @default(USER)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  auditLogs          AuditLog[]
  recentFiles        RecentFile[]
  judgePairs         JudgePair[]
  paragraphTemplates ParagraphTemplate[]
  cloudFiles         CloudFile[]
  accounts           Account[]
  emailOtps          EmailOtp[]

  @@map("users")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resource   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  status     String   @default("SUCCESS")
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model RecentFile {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName      String
  encryptedPath String
  fileType      String?
  lastOpenedAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([lastOpenedAt])
  @@map("recent_files")
}

model JudgePair {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  judge1Name String
  judge2Name String
  courtName  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@map("judge_pairs")
}

model ParagraphTemplate {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("paragraph_templates")
}

model CloudFile {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName  String
  s3Key     String
  fileSize  Int
  mimeType  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("cloud_files")
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String   @default("oauth")
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model EmailOtp {
  id        String   @id @default(uuid())
  email     String
  otpHash   String
  purpose   String   // RESET_PASSWORD | CHANGE_EMAIL
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts  Int      @default(0)
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([userId])
  @@index([expiresAt])
  @@map("email_otps")
}
