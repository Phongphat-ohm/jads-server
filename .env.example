# Database connection
DATABASE_URL="postgresql://user:password@localhost:5432/jads"

# Server Port
PORT=3000

# Authentication (JWT)
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"

# Recent Files Local Path Encryption (32-byte / 64-hex-char key for AES-256-GCM)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
