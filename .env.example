# ==============================================================================
# JADS SERVER ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://username:password@localhost:5432/jads"

# ------------------------------------------------------------------------------
# 2. Server Network & Security Settings
# ------------------------------------------------------------------------------
PORT=3000

# JSON Web Token (JWT) secret for signing user tokens
JWT_SECRET="your_secure_random_jwt_secret_here"
JWT_EXPIRES_IN="7d"

# AES-256-GCM encryption key for securing confidential local file paths (64 hex characters)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Allowed CORS Origins (comma-separated URLs)
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# ------------------------------------------------------------------------------
# 3. Email & OTP Verification (Resend API)
# ------------------------------------------------------------------------------
# API Key from https://resend.com (Leave empty to enable console emulation mode)
RESEND_API_KEY=""

# Sender email identity (verified domain in Resend or default onboarding)
EMAIL_FROM="JADS System <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# 4. S3 Object Storage (Cloud Files)
# ------------------------------------------------------------------------------
S3_ENDPOINT="https://s3.your-domain.com"
S3_BUCKET="jads"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your_s3_access_key"
S3_SECRET_ACCESS_KEY="your_s3_secret_key"
S3_USE_SSL="true"
